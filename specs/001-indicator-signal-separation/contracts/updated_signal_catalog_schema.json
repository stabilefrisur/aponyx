{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Signal Catalog Schema (Updated)",
  "description": "JSON schema for signal_catalog.json with indicator-signal separation support",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Unique signal identifier (lowercase, underscores only)",
        "examples": ["cdx_etf_basis", "cdx_vix_gap", "spread_momentum"]
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "description": "Human-readable explanation of signal trading logic"
      },
      "indicator_dependencies": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "minItems": 1,
        "description": "List of indicator names required for this signal (NEW pattern)"
      },
      "transformations": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "description": "List of transformation names to apply to indicators (NEW pattern)"
      },
      "composition_logic": {
        "type": "string",
        "description": "Optional Python expression for combining multiple indicators",
        "examples": ["indicator_a - indicator_b", "indicator_a / indicator_b"]
      },
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Whether signal is available for use"
      },
      "sign_multiplier": {
        "type": "integer",
        "enum": [1, -1],
        "default": 1,
        "description": "Sign convention multiplier (1 = no change, -1 = invert)"
      },
      "compute_function_name": {
        "type": "string",
        "pattern": "^compute_[a-z][a-z0-9_]*$",
        "description": "DEPRECATED: Legacy pattern for backward compatibility",
        "deprecated": true
      },
      "data_requirements": {
        "type": "object",
        "description": "DEPRECATED: Moved to indicator catalog",
        "deprecated": true
      },
      "arg_mapping": {
        "type": "array",
        "description": "DEPRECATED: Legacy pattern",
        "deprecated": true
      },
      "default_securities": {
        "type": "object",
        "description": "DEPRECATED: Moved to indicator catalog",
        "deprecated": true
      }
    },
    "required": ["name", "description", "enabled"],
    "oneOf": [
      {
        "description": "NEW pattern: indicator-based signal composition",
        "required": ["indicator_dependencies"],
        "properties": {
          "indicator_dependencies": true,
          "transformations": true,
          "composition_logic": true
        }
      },
      {
        "description": "LEGACY pattern: direct compute function (for backward compatibility)",
        "required": ["compute_function_name", "data_requirements"],
        "properties": {
          "compute_function_name": true,
          "data_requirements": true,
          "arg_mapping": true,
          "default_securities": true
        }
      }
    ],
    "additionalProperties": false
  },
  "minItems": 1,
  "examples": [
    [
      {
        "name": "cdx_vix_gap",
        "description": "Cross-asset risk sentiment divergence signal",
        "indicator_dependencies": ["cdx_vix_deviation_gap_20d"],
        "transformations": ["z_score_20d"],
        "enabled": true,
        "sign_multiplier": 1
      },
      {
        "name": "spread_momentum",
        "description": "Volatility-adjusted spread momentum",
        "indicator_dependencies": ["spread_change_5d"],
        "transformations": ["volatility_adjust_20d"],
        "enabled": true,
        "sign_multiplier": -1
      }
    ]
  ]
}
