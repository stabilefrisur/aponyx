{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Transformation Catalog Schema",
  "description": "JSON schema for transformation_catalog.json defining reusable signal transformations",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "name",
      "description",
      "transform_type",
      "parameters"
    ],
    "properties": {
      "name": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$",
        "description": "Unique transformation identifier (lowercase, underscores only)",
        "examples": ["z_score_20d", "volatility_adjust_5d", "normalize_60d"]
      },
      "description": {
        "type": "string",
        "minLength": 10,
        "description": "Human-readable explanation of transformation logic",
        "examples": ["Z-score normalization over 20-day rolling window"]
      },
      "transform_type": {
        "type": "string",
        "enum": ["diff", "pct_change", "log_return", "z_score", "normalized_change"],
        "description": "Type of transformation from data.transforms module"
      },
      "parameters": {
        "type": "object",
        "description": "Fixed transformation parameters",
        "properties": {
          "window": {
            "type": "integer",
            "minimum": 1,
            "description": "Rolling window size (required for z_score, normalized_change)"
          },
          "min_periods": {
            "type": "integer",
            "minimum": 1,
            "description": "Minimum observations required for rolling calculations"
          },
          "periods": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Number of periods for differencing operations"
          }
        },
        "additionalProperties": false
      },
      "enabled": {
        "type": "boolean",
        "default": true,
        "description": "Whether transformation is available for use"
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "transform_type": {
              "enum": ["z_score", "normalized_change"]
            }
          }
        },
        "then": {
          "properties": {
            "parameters": {
              "required": ["window"]
            }
          }
        }
      }
    ]
  },
  "minItems": 1,
  "examples": [
    [
      {
        "name": "z_score_20d",
        "description": "Z-score normalization over 20-day window",
        "transform_type": "z_score",
        "parameters": {
          "window": 20,
          "min_periods": 10
        },
        "enabled": true
      },
      {
        "name": "diff_5d",
        "description": "5-day first difference",
        "transform_type": "diff",
        "parameters": {
          "periods": 5
        },
        "enabled": true
      }
    ]
  ]
}
